# Copy to .env.local and fill in. Never commit the filled-in file.
# Used only by scripts/seed.ts, which YOU run locally. Use a throwaway testnet-only key.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=0x5f0fef71e66bfa218811dff6d633a5853c86eb57a4a34dd0828ee831aa39f124
# Seconds a governance proposal stays open (default 600).
VOTING_PERIOD=600

# --- Envio HyperIndex (frontend) ---
# GraphQL endpoint of the indexer in /indexer. Local `envio dev` serves http://localhost:8080/v1/graphql.
# Leave empty to read the leaderboard straight from the contracts.
NEXT_PUBLIC_ENVIO_URL=http://localhost:8080/v1/graphql

# --- KIMI Campaign Copilot (server only, never NEXT_PUBLIC_) ---
# Key from https://platform.kimi.ai. Leave empty and the copilot shows as offline.
MOONSHOT_API_KEY=
# Optional overrides.
KIMI_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1